  "summary": "Compost growth hardening scenario (poor soil, feature 004).",
  "playerRole": "host",
  "minimumGameVersion": "1.6.14",
  "environment": {
    "gameVersion": "1.6.14",
    "smapiVersion": "4.4.0",
    "modVersion": "0.1.0",
    "apiVersion": "1.0.0",
    "saveId": "farm-year1-day5",
    "config": {
      "saveMode": "save",
      "headless": true,
      "skipBuild": false
    }
  },
  "milestoneSave": "farm-year1-day5",
  "initCommands": [
    {
      "kind": "console",
      "command": "lr_plant_crop 60 15 LivingRoots.Verification.LongPhaseCrop",
      "description": "plant a verification-only dry crop on the target tile"
    },
    {
      "kind": "console",
      "command": "lr_set_soil_health 60 15 10",
      "description": "seed poor soil on the target tile"
    },
    {
      "kind": "console",
      "command": "lr_place_bin 60 15",
      "description": "place the composting bin on the target tile"
    }
  ],
  "steps": [
    {
      "action": "insertWaste",
      "target": "60,15",
      "inputs": {
        "itemId": "24",
        "count": 5
      }
    },
    {
      "action": "sleep",
      "target": "farm",
      "days": 5
    },
    {
      "action": "dumpCropPhase",
      "target": "farm"
    },
    {
      "action": "observe",
      "target": "60,15"
    }
  ],
  "thresholds": [
    {
      "signal": "cropPhaseDelta",
      "predicate": {
        "op": "multiplier",
        "field": "phaseDays",
        "base": "pre.phaseDays",
        "tolerance": 0.0001,
        "factor": 1.15
      },
      "description": "poor soil slows growth by 1.15x"
    },
    {
      "signal": "soilHealthStateDelta",
      "predicate": {
        "op": "between",
        "field": "soilHealth",
        "min": 0,
        "max": 34,
        "tolerance": 0.0001,
        "exclusiveMin": true,
        "exclusiveMax": true
      },
      "description": "stored health stays in the Poor interval (0, 34)"
    }
  ],
  "expectedSignals": [
    "soilHealthStateDelta",
    "cropPhaseDelta",
    "smapiLog"
  ],
  "timeoutSeconds": 300,
  "inputs": {
    "season": "spring",
    "day": 5,
    "weather": "sunny",
    "money": 500
  },
  "rngSeed": 123456789,
