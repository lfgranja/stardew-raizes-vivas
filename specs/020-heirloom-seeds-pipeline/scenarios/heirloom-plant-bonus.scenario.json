{
  "schemaVersion": 3,
  "scenarioId": "heirloom-plant-bonus-host-only",
  "featureSlug": "020-heirloom-seeds-pipeline",
  "testMdPath": "specs/020-heirloom-seeds-pipeline/test.md",
  "summary": "020 crioulo parsnip (host-only): till tile 60,15, seed measured 50 soil, then grant+plant through the production HoeDirt.plant path (lr_sow_heirloom) — measured soil rises to 52 (+HeirloomPlantBonus=2, a labeled game abstraction).",
  "playerRole": "host",
  "minimumGameVersion": "1.6.14",
  "environment": {
    "gameVersion": "1.6.14",
    "smapiVersion": "4.4.0",
    "modVersion": "0.1.0",
    "apiVersion": "1.0.0",
    "saveId": "farm-year1-day5",
    "config": {
      "saveMode": "save",
      "headless": true,
      "skipBuild": false
    }
  },
  "milestoneSave": "farm-year1-day5",
  "initCommands": [
    {
      "kind": "console",
      "command": "lr_till 60 15",
      "description": "till the target tile (creates HoeDirt; plant requires dirt)"
    },
    {
      "kind": "console",
      "command": "lr_set_soil_health 60 15 50",
      "description": "seed measured 50 soil health on the target tile"
    }
  ],
  "steps": [
    {
      "action": "runMacro",
      "target": "60,15",
      "inputs": {
        "macroFile": "macros/heirloom-sow.txt"
      }
    },
    {
      "action": "sleep",
      "target": "farm",
      "days": 1
    },
    {
      "action": "dumpCropPhase",
      "target": "farm"
    },
    {
      "action": "observe",
      "target": "60,15"
    }
  ],
  "thresholds": [
    {
      "signal": "soilHealthStateDelta",
      "predicate": {
        "op": "multiplier",
        "field": "soilHealth",
        "base": "pre.soilHealth",
        "factor": 1.04,
        "tolerance": 0.0001
      },
      "description": "measured 50 soil after one heirloom plant rises to 52 (+HeirloomPlantBonus)"
    },
    {
      "signal": "cropPhaseDelta",
      "predicate": {
        "op": "allOf",
        "predicates": [
          {
            "op": "cmp",
            "left": "phaseDays",
            "operator": "eq",
            "right": 1,
            "tolerance": 0.0001
          },
          {
            "op": "cmp",
            "left": "currentPhase",
            "operator": "eq",
            "right": 0,
            "tolerance": 0.0001
          },
          {
            "op": "cmp",
            "left": "fullyGrown",
            "operator": "eq",
            "right": false,
            "tolerance": 0
          }
        ]
      },
      "description": "planting advances nothing: phase 0 with the declared 1-day phase budget, not fully grown (no 014/015 double-count)"
    },
    {
      "signal": "smapiLog",
      "predicate": {
        "op": "cmp",
        "left": "isMainPlayer",
        "operator": "eq",
        "right": true,
        "tolerance": 0
      },
      "description": "host/main-player application only (no unsafe local-only state)"
    }
  ],
  "expectedSignals": [
    "soilHealthStateDelta",
    "cropPhaseDelta",
    "smapiLog"
  ],
  "timeoutSeconds": 300,
  "inputs": {
    "season": "spring",
    "day": 5,
    "weather": "sunny",
    "money": 500
  },
  "rngSeed": 123456789,
  "time": "2026-11-09T12:00:00Z",
  "scenarioKind": "positive",
  "expectedVerdict": "pass",
  "determinism": {
    "idempotent": true,
    "declaredSources": []
  }
}
