{
  "schemaVersion": 3,
  "scenarioId": "mulch-refused-on-ineligible",
  "featureSlug": "013-mulch-soil-cover",
  "testMdPath": "specs/013-mulch-soil-cover/test.md",
  "summary": "013 host: second mulch apply on already-mulched tile is refused (FR-013 ineligible/already); soil unchanged, no generation failure (attestable refusal).",
  "playerRole": "host",
  "minimumGameVersion": "1.6.14",
  "environment": {
    "gameVersion": "1.6.14",
    "smapiVersion": "4.4.0",
    "modVersion": "0.1.0",
    "apiVersion": "1.0.0",
    "saveId": "farm-year1-day5",
    "config": {
      "saveMode": "save",
      "headless": true,
      "skipBuild": true
    }
  },
  "milestoneSave": "farm-year1-day5",
  "initCommands": [
    {
      "kind": "console",
      "command": "lr_plant_crop 60 15 LivingRoots.Verification.LongPhaseCrop",
      "description": "plant a verification-only crop on tilled target tile"
    },
    {
      "kind": "console",
      "command": "lr_set_soil_health 60 15 50",
      "description": "seed measured soil health on the target tile"
    }
  ],
  "steps": [
    {
      "action": "runMacro",
      "target": "60,15",
      "inputs": {
        "macroFile": "macros/mulch-apply-twice.txt"
      }
    },
    {
      "action": "sleep",
      "target": "farm",
      "days": 1
    },
    {
      "action": "dumpCropPhase",
      "target": "farm"
    },
    {
      "action": "observe",
      "target": "60,15"
    }
  ],
  "thresholds": [
    {
      "signal": "soilHealthStateDelta",
      "predicate": {
        "op": "multiplier",
        "field": "soilHealth",
        "base": "pre.soilHealth",
        "factor": 1.0,
        "tolerance": 0.0001
      },
      "description": "already-mulched refusal causes no soil mutation; first apply also does not mutate soil"
    },
    {
      "signal": "cropPhaseDelta",
      "predicate": {
        "op": "multiplier",
        "field": "phaseDays",
        "base": "pre.phaseDays",
        "factor": 1.0,
        "tolerance": 0.0001
      },
      "description": "LongPhaseCrop phaseDays unchanged in 1-day capture flow (stable capture)"
    },
    {
      "signal": "smapiLog",
      "predicate": {
        "op": "cmp",
        "left": "isMainPlayer",
        "operator": "eq",
        "right": true,
        "tolerance": 0
      },
      "description": "host/main-player path"
    }
  ],
  "expectedSignals": [
    "soilHealthStateDelta",
    "cropPhaseDelta",
    "smapiLog"
  ],
  "timeoutSeconds": 300,
  "inputs": {
    "season": "spring",
    "day": 5,
    "weather": "sunny",
    "money": 500
  },
  "rngSeed": 123456789,
  "time": "2026-11-07T12:00:00Z",
  "scenarioKind": "negative",
  "expectedVerdict": "pass",
  "determinism": {
    "idempotent": true,
    "declaredSources": []
  }
