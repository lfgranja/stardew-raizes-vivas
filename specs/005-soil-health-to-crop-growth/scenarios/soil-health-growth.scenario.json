{
  "schemaVersion": 2,
  "scenarioId": "soil-health-growth-healthy-soil",
  "featureSlug": "005-soil-health-to-crop-growth",
  "testMdPath": "specs/005-soil-health-to-crop-growth/test.md",
  "summary": "Soil health to crop growth scenario (healthy soil 80, feature 005): 0.85x phaseDays on 60,15.",
  "playerRole": "host",
  "minimumGameVersion": "1.6.14",
  "environment": {
    "gameVersion": "1.6.14",
    "smapiVersion": "4.4.0",
    "modVersion": "0.1.0",
    "apiVersion": "1.0.0",
    "saveId": "farm-year1-day5",
    "config": {
      "saveMode": "save",
      "headless": true,
      "skipBuild": true
    }
  },
  "milestoneSave": "farm-year1-day5",
  "initCommands": [
    {
      "kind": "console",
      "command": "lr_plant_crop 60 15 LivingRoots.Verification.LongPhaseCrop",
      "description": "plant a verification-only crop on the target tile"
    },
    {
      "kind": "console",
      "command": "lr_set_soil_health 60 15 80",
      "description": "seed healthy soil on the target tile"
    }
  ],
  "steps": [
    {
      "action": "sleep",
      "target": "farm",
      "days": 5
    },
    {
      "action": "dumpCropPhase",
      "target": "farm"
    },
    {
      "action": "observe",
      "target": "60,15"
    }
  ],
  "thresholds": [
    {
      "signal": "cropPhaseDelta",
      "predicate": {
        "op": "multiplier",
        "field": "phaseDays",
        "base": "pre.phaseDays",
        "tolerance": 0.0001,
        "factor": 0.85
      },
      "description": "healthy soil speeds growth by 0.85x"
    },
    {
      "signal": "soilHealthStateDelta",
      "predicate": {
        "op": "between",
        "field": "soilHealth",
        "min": 67,
        "max": 100,
        "tolerance": 0.0001,
        "exclusiveMin": false,
        "exclusiveMax": true
      },
      "description": "stored health stays in the Healthy interval [67, 100)"
    }
  ],
  "expectedSignals": [
    "soilHealthStateDelta",
    "cropPhaseDelta",
    "smapiLog"
  ],
  "timeoutSeconds": 300,
  "inputs": {
    "season": "spring",
    "day": 5,
    "weather": "sunny",
    "money": 500
  },
  "rngSeed": 987654321,
  "time": "2026-10-27T12:00:00Z",
  "scenarioKind": "positive",
  "expectedVerdict": "pass",
  "determinism": {
    "idempotent": true,
    "declaredSources": []
  }
}
