      "description": "measured 5 with P=10 clamps to 0"
    },
    {
      "signal": "cropPhaseDelta",
      "predicate": {
        "op": "multiplier",
        "field": "phaseDays",
        "base": "pre.phaseDays",
        "factor": 1.15,
        "tolerance": 0.0001
      },
      "description": "post-clamp soil 0 is poor (005 1.15x); no agrochemical double-counting beyond soil-health-driven growth"
    },
    {
      "signal": "smapiLog",
      "predicate": {
        "op": "cmp",
        "left": "isMainPlayer",
        "operator": "eq",
        "right": true,
        "tolerance": 0
