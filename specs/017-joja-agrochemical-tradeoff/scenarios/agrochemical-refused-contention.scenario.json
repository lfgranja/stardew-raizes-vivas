  "featureSlug": "017-joja-agrochemical-tradeoff",
  "testMdPath": "specs/017-joja-agrochemical-tradeoff/test.md",
  "summary": "017 host (authorized contention seam): lock held by other farmerId -> agrochemical apply hits controller lock-contention (action-conflict / RefusedConflict reserved context), refusal logged, no mutation/consumption on failed path, soil unchanged (1.0x). Deterministic via lr_acquire/release_host_lock.",
  "playerRole": "host",
  "minimumGameVersion": "1.6.14",
  "environment": {
    "gameVersion": "1.6.14",
    "smapiVersion": "4.4.0",
    "modVersion": "0.1.0",
    "apiVersion": "1.0.0",
    "saveId": "farm-year1-day5",
    "config": {
      "saveMode": "save",
      "headless": true,
      "skipBuild": true
    }
  },
  "milestoneSave": "farm-year1-day5",
  "initCommands": [
    {
      "kind": "console",
      "command": "lr_plant_crop 60 15 LivingRoots.Verification.LongPhaseCrop",
      "description": "plant a verification-only dry crop on the target tile"
    },
    {
      "kind": "console",
      "command": "lr_set_soil_health 60 15 50",
      "description": "seed measured soil health on the target tile"
    }
  ],
  "steps": [
    {
      "action": "runMacro",
      "target": "60,15",
      "inputs": {
        "macroFile": "macros/agrochemical-contention.txt"
      }
    },
    {
      "action": "sleep",
      "target": "farm",
      "days": 1
    },
    {
      "action": "dumpCropPhase",
      "target": "farm"
    },
    {
      "action": "observe",
      "target": "60,15"
    }
  ],
  "thresholds": [
    {
      "signal": "soilHealthStateDelta",
      "predicate": {
        "op": "multiplier",
        "field": "soilHealth",
        "base": "pre.soilHealth",
        "factor": 1.0,
        "tolerance": 0.0001
      },
      "description": "lock contention refuses apply (action-conflict); soil unchanged"
    },
    {
      "signal": "cropPhaseDelta",
      "predicate": {
        "op": "multiplier",
        "field": "phaseDays",
        "base": "pre.phaseDays",
        "factor": 1.0,
        "tolerance": 0.0001
      },
      "description": "no mutation; LongPhaseCrop phaseDays stable in 1-day capture flow"
    },
    {
      "signal": "smapiLog",
      "predicate": {
        "op": "cmp",
        "left": "isMainPlayer",
        "operator": "eq",
        "right": true,
        "tolerance": 0
      },
      "description": "host context (contention exercised via authorized lock seam)"
    }
  ],
  "expectedSignals": [
    "soilHealthStateDelta",
    "cropPhaseDelta",
    "smapiLog"
  ],
  "timeoutSeconds": 300,
  "inputs": {
    "season": "spring",
    "day": 5,
    "weather": "sunny",
    "money": 500
  },
  "rngSeed": 123456789,
  "time": "2026-11-07T12:00:00Z",
