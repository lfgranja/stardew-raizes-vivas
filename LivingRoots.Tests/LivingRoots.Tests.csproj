<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <BundleExtraAssemblies>All</BundleExtraAssemblies>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SuppressTfmSupportBuildErrors>true</SuppressTfmSupportBuildErrors>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed README.md as a resource for reliable test access -->
    <EmbeddedResource Include="..\README.md" Link="Resources\README.md" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Optional override path; leave empty by default -->
    <SmapiInternalPath>$(NuGetPackageRoot)pathoschild.stardew.modbuildconfig/4.4.0/build</SmapiInternalPath>
    <SmapiInternalPath Condition="'$(SmapiInternalPath)'==''"></SmapiInternalPath>
  </PropertyGroup>

  <Target Name="CopySMAPIAssemblies" AfterTargets="Build" Condition="'$(SmapiInternalPath)'!=''">
    <ItemGroup>
      <SMAPIFiles Include="$(SmapiInternalPath)/*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SMAPIFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Provides the "XPlat Code Coverage" data collector used to emit coverage.opencover.xml -->
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- T001 (spec 004 Phase 1): property-based invariant testing over arbitrary
         inputs (bin lifecycle, soil health bounds, concurrency) — required by the
         strict TDD blocker for Fases 10-15. -->
    <PackageReference Include="FsCheck" Version="3.6.0" />
    <PackageReference Include="FsCheck.Xunit" Version="3.6.0" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <!-- Override vulnerable transitive deps (CVE-2017-11770, CVE-2018-8292) -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.X509Certificates" Version="4.3.2" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" PrivateAssets="all" />


  </ItemGroup>

  <ItemGroup>
     <ProjectReference Include="..\LivingRoots\LivingRoots.csproj" />

  </ItemGroup>

</Project>
